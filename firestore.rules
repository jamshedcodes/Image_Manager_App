rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /images/{imageId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 0
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.size() > 0
        && request.resource.data.referenceName is string
        && request.resource.data.referenceName.size() > 0
        && request.resource.data.createdAt == request.time;

      allow delete: if request.auth != null
        && resource.data.uploadedBy == request.auth.uid;

      allow update: if false;
    }
  }
}
